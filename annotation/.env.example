# Copy to .env (git-ignored) or set these in your hosting provider's dashboard.

# Defaults to the SQLite file annotation/annotation.db. When hosted, use Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# How many experts should label each series.
TARGET_ANNOTATIONS=3

# Queue order: "active" (random at first, then mostly series the model is unsure about), "random", "spread" or "complete" (finish series to the target first,
# so consensus labels and agreement stats appear early).
QUEUE_ORDER=active

# true when served over HTTPS (always, in production).
COOKIE_SECURE=false

# Optional
# SESSION_MAX_AGE=1209600
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_SECONDS=900
